# Copy to .env; supply a real CSV path at launch. Never commit credentials.
CSV_PATH=./tests/fixtures/demo.csv
INITIAL_ROWS=500
BATCH_ROWS=100
BATCH_INTERVAL=1
DEVIATION_THRESHOLD=6
LLM_ENABLED=false
LLM_ENDPOINT=https://containers.datacrunch.io/data-sovereignty-mistral-large-3/v1/chat/completions
# Exact identifier returned by the supplied endpoint's /v1/models route.
LLM_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512-NVFP4
LLM_API_KEY=
LLM_TIMEOUT=30

# Copy to .env; mount a data directory at launch. Never commit credentials.
DATA_DIR=./tests/fixtures
# For native development, DATA_PATH is an absolute path inside DATA_DIR.
INITIAL_ROWS=500
BATCH_ROWS=100
BATCH_INTERVAL=10
DEVIATION_THRESHOLD=6
LLM_ENABLED=false
LLM_ENDPOINT=https://containers.datacrunch.io/data-sovereignty-mistral-large-3/v1/chat/completions
# Exact identifier returned by the supplied endpoint's /v1/models route.
LLM_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512-NVFP4
LLM_API_KEY=
LLM_TIMEOUT=30
